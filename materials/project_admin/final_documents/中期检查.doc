<body lang="ZH-CN" style='text-justify-trim: punctuation'>

    <div class="WordSection1" style='layout-grid: 15.6pt'>

        <p class="MsoNormal" align="center" style='text-align: center; line-height: 150%'>
            <b><span
                style='font-size: 14.0pt; line-height: 150%; font-family: 黑体'>东南大学毕业设计（论文）中期检查表</span></b>
        </p>

        <p class="MsoPlainText" align="center" style='text-align: center'>
            <span
                style='font-size: 12.0pt'>（学生用表）</span>
        </p>

        <table class="MsoNormalTable" border="1" cellspacing="0" cellpadding="0"
            style='border-collapse: collapse; border: none'>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="85" style='width: 63.55pt; border: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>学号</p>
                </td>
                <td width="206" colspan="2" style='width: 154.5pt; border: solid windowtext 1.0pt; border-left: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText"><span lang="EN-US">08122215</span></p>
                </td>
                <td width="87" style='width: 65.2pt; border: solid windowtext 1.0pt; border-left: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>
                        <span
                            style='font-family: 宋体'>姓名</span>
                    </p>
                </td>
                <td width="206" style='width: 154.15pt; border: solid windowtext 1.0pt; border-left: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText"><span lang="EN-US">张洋</span></p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="85" style='width: 63.55pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>学院</p>
                </td>
                <td width="206" colspan="2" style='width: 154.5pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText"><span lang="EN-US">自动化学院</span></p>
                </td>
                <td width="87" style='width: 65.2pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>
                        <span
                            style='font-family: 宋体'>专业</span>
                    </p>
                </td>
                <td width="206" style='width: 154.15pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText"><span lang="EN-US">机器人工程</span></p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="85" style='width: 63.55pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>课题名称</p>
                </td>
                <td width="498" colspan="4" style='width: 373.85pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>
                        <span
                            lang="EN-US">好奇心驱动的无人机主动定位目标导航方法</span>
                    </p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="192" colspan="2" style='width: 144.0pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>毕业设计（论文）进展</p>
                </td>
                <td width="391" colspan="3" style='width: 293.4pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" align="center" style='text-align: center'>
                        <span
                            style='color: black'>□提前</span><span lang="EN-US" style='font-family: "Tahoma","sans-serif"; color: black'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><span
                                style='color: black'>√正常</span><span style='font-family: "Tahoma","sans-serif"; color: black'> <span lang="EN-US">&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span
                                    style='color: black'>□滞后</span>
                    </p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="583" colspan="5" style='width: 437.4pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" style='margin-left: 18.0pt; text-indent: -18.0pt'>
                        <span
                            lang="EN-US">1、<span style='font: 7.0pt "Times New Roman"'> </span></span>现阶段已完成的工作
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Times New Roman","serif"; color: black'>已完成课题相关理论学习与技术路线设计，构建了融合内在奖励与外在奖励的无人机导航模型；完成仿真平台搭建与测试场景构建，实现了无人机在未知环境中的基本搜索与导航功能，并开展了初步实验验证。</span>
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Times New Roman","serif"; color: black'>&nbsp;</span>
                    </p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="583" colspan="5" style='width: 437.4pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" style='margin-left: 18.0pt; text-indent: -18.0pt'>
                        <span
                            lang="EN-US">2、<span style='font: 7.0pt "Times New Roman"'> </span></span>下一步工作计划
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Times New Roman","serif"; color: black'>后续将重点优化奖励机制，研究内外奖励的动态平衡方法（如门控函数与自适应权重），提升导航成功率；同时开展参数调优与对比实验，完成实验分析与论文撰写。</span>
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Times New Roman","serif"; color: black'>&nbsp;</span>
                    </p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="583" colspan="5" style='width: 437.4pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" style='margin-left: 18.0pt; text-indent: -18.0pt'>
                        <span
                            lang="EN-US">3、<span style='font: 7.0pt "Times New Roman"'> </span></span>存在的问题及解决方法
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Tahoma","sans-serif"; color: black'>当前模型成功率仍有提升空间，主要问题在于内在奖励与外在奖励采用固定权重叠加，缺乏动态调节机制。后续将通过引入门控函数与自适应奖励调度策略，实现探索与目标导向之间的平衡，从而提升模型性能。</span>
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Tahoma","sans-serif"; color: black'>&nbsp;</span>
                    </p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="583" colspan="5" style='width: 437.4pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" style='margin-left: 18.0pt; text-indent: -18.0pt'>
                        <span
                            lang="EN-US">4、<span style='font: 7.0pt "Times New Roman"'> </span></span>平均每周与指导教师沟通或见面次数（或时长）
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Tahoma","sans-serif"; color: black'>一周一次</span>
                    </p>
                    <p class="MsoPlainText">
                        <span lang="EN-US" style='font-family: "Tahoma","sans-serif"; color: black'>&nbsp;</span>
                    </p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 22.7pt'>
                <td width="583" colspan="5" style='width: 437.4pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 22.7pt'>
                    <p class="MsoPlainText" style='margin-left: 18.0pt; text-indent: -18.0pt'>
                        <span
                            lang="EN-US">5、<span style='font: 7.0pt "Times New Roman"'> </span></span>在毕业设计开展的过程中，你是否得到了指导教师的有力指导？
                    </p>
                    <p class="MsoPlainText" style='text-indent: 21.0pt'><a name="two1"></a>√得到有力的指导</p>
                    <p class="MsoPlainText" style='text-indent: 21.0pt'><a name="two2"></a>□得到一般性的指导</p>
                    <p class="MsoPlainText" style='margin-left: 21.0pt'><a name="two3"></a>□得到少许指导</p>
                    <p class="MsoPlainText" style='margin-left: 21.0pt'>□没有得到指导</p>
                </td>
            </tr>
            <tr style='page-break-inside: avoid; height: 85.95pt'>
                <td width="583" colspan="5" style='width: 437.4pt; border: solid windowtext 1.0pt; border-top: none; padding: 0cm 5.4pt 0cm 5.4pt; height: 85.95pt'>
                    <p class="MsoPlainText" style='margin-left: 18.0pt; text-indent: -18.0pt'>
                        <span
                            lang="EN-US">6、<span style='font: 7.0pt "Times New Roman"'> </span></span>指导老师审核意见
                    </p>
                    <p class="MsoPlainText"><span lang="EN-US">毕业设计按计划推进，已完成的工作质量较高。</span></p>
                    <p class="MsoPlainText"><span lang="EN-US">&nbsp;</span></p>
                    <p class="MsoPlainText"  style='margin-top: 0cm; margin-right: 42.0pt; margin-bottom: 0cm; margin-left: 8.9pt; margin-bottom: .0001pt; text-indent: 200.0pt'>
                        <span lang="EN-US">
                        </span>指导老师签字：<img src='data:image/jpeg;base64,'  width='70' height='35' runat='server' />
                    </p>
                    <p class="MsoPlainText" style='margin-top: 0cm; margin-right: 42.0pt; margin-bottom: 0cm; margin-left: 8.9pt; margin-bottom: .0001pt; text-indent: 200.0pt'>
                        日期：2026年04月22日
                    </p>
                </td>
            </tr>
            <tr height="0">
                <td width="85" style='border: none'></td>
                <td width="107" style='border: none'></td>
                <td width="99" style='border: none'></td>
                <td width="87" style='border: none'></td>
                <td width="206" style='border: none'></td>
            </tr>
        </table>

        <p class="MsoNormal"><span lang="EN-US">&nbsp;</span></p>

    </div>
</body>

</html>

